Table User {
    id int [pk]
    first_name varchar
    last_name varchar
    account_created Date
}

Table User_interactions {
    id int [pk]
}


Table Film {
    id int [pk]
    title varchar
    duration int
    genre varchar

}

Table Tv_show {
    id int [pk]
    title varchar
    duration int
    genre varchar

}

Table Actor {
    id int [pk]
    first_name varchar
    last_name varchar
    
}

Table Director {
    id int [pk]
    first_name varchar
    last_name varchar

}

Table Film_actors{
    actor_id int [not null, Ref: > Actor.id] //FK
    film_id int [not null, Ref: > Film.id] //FK
}

Table Tv_actors{
    actor_id int [not null, Ref: > Actor.id] //FK
    tv_show_id int [not null, Ref: > Tv_show.id] //FK
}

Table Film_directors{
    director_id int [not null, Ref: > Director.id] //FK
    films_id int [not null, Ref: > Film.id] //FK
}

Table Tv_directors{
    director_id int [not null, Ref: > Director.id] //FK
    tv_show_id int [not null, Ref: > Tv_show.id] //FK
}