
Table User_Account {
    account_id int [pk]
    email varchar [not null]
    password varchar [not null]
    phone_number varchar
    subscription_id int [ref: > subscription.subscription_id]
    account_created Date
}

Table Subscription {
    subscription_id int [pk]
    subscription_type varchar [not null]
    subscription_price decimal [not null]
    subscription_duration int [not null]
}

Table Profile {
    account_id int [ref: > user_Account.account_id]
    profile_id int [pk]
    profile_name varchar [not null]
    profile_picture varchar
    is_kid_profile boolean [not null]
}

Table Watched {
    profile_id int [ref: > profile.profile_id]
    is_watched boolean [not null]
    film_id int [not null, Ref: > Film.id]
    tv_show_id int [not null, Ref: > Tv_show.id]
}

Table Liked {
    profile_id int [ref: > profile.profile_id]
    is_liked boolean [not null]
    film_id int [not null, Ref: > Film.id]
    tv_show_id int [not null, Ref: > Tv_show.id]
}

Table Film {
    id int [pk]
    title varchar
    duration int
    genre varchar

}

Table Tv_show {
    id int [pk]
    title varchar
    duration int
    genre varchar

}

Table Actor {
    id int [pk]
    first_name varchar
    last_name varchar
    
}

Table Director {
    id int [pk]
    first_name varchar
    last_name varchar

}

Table Film_actors{
    actor_id int [not null, Ref: > Actor.id] //FK
    film_id int [not null, Ref: > Film.id] //FK
}

Table Tv_actors{
    actor_id int [not null, Ref: > Actor.id] //FK
    tv_show_id int [not null, Ref: > Tv_show.id] //FK
}

Table Film_directors{
    director_id int [not null, Ref: > Director.id] //FK
    films_id int [not null, Ref: > Film.id] //FK
}

Table Tv_directors{
    director_id int [not null, Ref: > Director.id] //FK
    tv_show_id int [not null, Ref: > Tv_show.id] //FK
}