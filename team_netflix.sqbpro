<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="/Users/mikemini/Desktop/School/Fall Semester 26/Mac 250/Project/team_netflix.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1272"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="account" custom_title="0" dock_id="3" table="4,7:mainaccount"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE account (
    id INT PRIMARY KEY,
    email VARCHAR(255),
    password VARCHAR(64),
    phone_number VARCHAR(255),
    subscription_id INT,
    account_created DATETIME 
);

CREATE TABLE subscription (
    id INT PRIMARY KEY,
    subscription_type VARCHAR(255),
    subscription_price DECIMAL(10, 2),
    subscription_duration INT not null
);

CREATE TABLE profile (
    account_id INT,
    profile_id INT PRIMARY KEY,
    profile_name VARCHAR(255),
    profile_picture VARCHAR(255),
    is_kid_profile BOOLEAN NOT NULL,
    FOREIGN KEY (account_id) REFERENCES account (id)
);

CREATE TABLE watched (
    account_id INT,
    is_watched BOOLEAN NOT NULL,
    film_id INT,
    tv_show_id INT,
    FOREIGN KEY (account_id) REFERENCES account (id),
    FOREIGN KEY (film_id) REFERENCES film (id),
    FOREIGN KEY (tv_show_id) REFERENCES tv_show (id)
);

CREATE TABLE liked (
    account_id INT,
    is_liked BOOLEAN NOT NULL,
    film_id INT,
    tv_show_id INT,
    FOREIGN KEY (account_id) REFERENCES account (id),
    FOREIGN KEY (film_id) REFERENCES film (id),
    FOREIGN KEY (tv_show_id) REFERENCES tv_show (id)
);

CREATE TABLE film (
    id INT PRIMARY KEY,
    title VARCHAR(255),
    duration INT,
    genre VARCHAR(255)
);

CREATE TABLE tv_show (
    id INT PRIMARY KEY,
    title VARCHAR(255),
    duration INT,
    genre VARCHAR(255)
);

CREATE TABLE actor (
    id INT PRIMARY KEY,
    first_name VARCHAR(255),
    last_name VARCHAR(255)
);

CREATE TABLE director (
    id INT PRIMARY KEY,
    first_name VARCHAR(255),
    last_name VARCHAR(255)
);

CREATE TABLE film_actors (
    actor_id INT,
    film_id INT,
    FOREIGN KEY (actor_id) REFERENCES actor (id),
    FOREIGN KEY (film_id) REFERENCES film (id)
);

CREATE TABLE tv_actors (
    actor_id INT,
    tv_show_id INT,
    FOREIGN KEY (actor_id) REFERENCES actor (id),
    FOREIGN KEY (tv_show_id) REFERENCES tv_show (id)
);

CREATE TABLE film_directors (
    director_id INT,
    film_id INT,
    FOREIGN KEY (director_id) REFERENCES director (id),
    FOREIGN KEY (film_id) REFERENCES film (id)
);

CREATE TABLE tv_directors (
    director_id INT,
    tv_show_id INT,
    FOREIGN KEY (director_id) REFERENCES director (id),
    FOREIGN KEY (tv_show_id) REFERENCES tv_show (id)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
