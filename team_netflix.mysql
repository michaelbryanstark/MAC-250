CREATE TABLE user_account (
    account_id INT PRIMARY KEY,
    email VARCHAR(255),
    password VARCHAR(64),
    phone_number VARCHAR(255),
    subscription_id INT (ref: > subscription.subscription_id),
    account_created DATETIME
);

CREATE TABLE subscription (
    subscription_id INT PRIMARY KEY,
    subscription_type VARCHAR(255),
    subscription_price DECIMAL(10,2),
    subscription_duration INT (not null)
);

CREATE TABLE profile (
    account_id INT (ref: > user_Account.account_id),
    profile_id INT PRIMARY KEY,
    profile_name VARCHAR(255),
    profile_picture VARCHAR(255),
    is_kid_profile boolean (not null)
);

CREATE TABLE watched (
    profile_id INT (ref: > profile.profile_id),
    is_watched boolean (not null),
    film_id INT (not null, Ref: > Film.id),
    tv_show_id INT (not null, Ref: > Tv_show.id)
);

CREATE TABLE liked (
    profile_id INT (ref: > profile.profile_id),
    is_liked boolean (not null),
    film_id INT (not null, Ref: > Film.id),
    tv_show_id INT (not null, Ref: > Tv_show.id)
);

CREATE TABLE film (
    id INT PRIMARY KEY,
    title VARCHAR(255),
    duration INT,
    genre VARCHAR(255)
);

CREATE TABLE tv_show (
    id INT PRIMARY KEY,
    title VARCHAR(255),
    duration INT,
    genre VARCHAR(255)

);

CREATE TABLE actor (
    id INT PRIMARY KEY,
    first_name VARCHAR(255),
    last_name VARCHAR(255)
    
);

CREATE TABLE director (
    id INT PRIMARY KEY,
    first_name VARCHAR(255),
    last_name VARCHAR(255)

); 

CREATE TABLE film_actors (
    actor_id INT (not null, Ref: > Actor.id), 
    film_id INT (not null, Ref: > Film.id) 
);

CREATE TABLE tv_actors (
    actor_id INT (not null, Ref: > Actor.id), 
    tv_show_id INT (not null, Ref: > Tv_show.id) 
);

CREATE TABLE film_directors (
    director_id INT (not null, Ref: > Director.id), 
    films_id INT (not null, Ref: > Film.id) 
);

CREATE TABLE tv_directors (
    director_id INT (not null, Ref: > Director.id), 
    tv_show_id INT (not null, Ref: > Tv_show.id) 
);